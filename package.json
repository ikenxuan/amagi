{
  "name": "@ikenxuan/amagi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Amagi monorepo - 抖音、B站的 web 端相关数据接口基于 Node.js 的实现",
  "keywords": [
    "api",
    "bilibili",
    "douyin",
    "kuaishou",
    "monorepo",
    "xiaohongshu"
  ],
  "homepage": "https://github.com/ikenxuan/amagi",
  "bugs": {
    "url": "https://github.com/ikenxuan/amagi/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenxuan/amagi.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "build:core": "pnpm --filter=@ikenxuan/amagi run build",
    "build:docs": "pnpm --filter=docs run build",
    "clean": "pnpm -r --filter=./packages/* run clean",
    "deps:check": "dpdm --exit-code circular:1 packages/core/src/index.ts",
    "dev": "pnpm --filter=@ikenxuan/amagi run dev",
    "types-docs:build": "pnpm -r --filter=./packages/* run types-docs:build",
    "types-docs:serve": "pnpm --filter=@ikenxuan/amagi run types-docs:serve",
    "docs:dev": "pnpm --filter=docs run dev",
    "fix": "pnpm -r --filter=./packages/* run fix",
    "lint": "pnpm -r --filter=./packages/* run lint",
    "prepare": "husky",
    "sort": "pnpm -r --filter=./packages/* run sort",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.enabled",
    "test:coverage": "vitest run --coverage",
    "openapi": "pnpm --filter @ikenxuan/amagi run gen:openapi",
    "openapi:check": "pnpm --filter @ikenxuan/amagi run gen:openapi:check"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "10.1.0",
    "dpdm": "4.3.0",
    "globals": "17.8.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "sort-package-json": "4.0.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.22.14",
    "tsx": "4.23.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}

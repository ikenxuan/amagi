{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:core && cross-env NODE_ENV=production next build",
    "build:core": "pnpm --filter @ikenxuan/amagi build",
    "dev": "pnpm build:core && next dev",
    "fix": "oxfmt",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint .",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ikenxuan/amagi": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-twoslash": "^3.3.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "twoslash": "^0.3.9",
    "winston": "^3.19.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "code-inspector-plugin": "^1.6.6",
    "cross-env": "10.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
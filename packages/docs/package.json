{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:core && pnpm docs:api && pnpm check:includes && pnpm check:twoslash && pnpm check:sidebar && cross-env NODE_ENV=production next build && pnpm check:links",
    "build:core": "pnpm --filter @ikenxuan/amagi build",
    "dev": "pnpm build:core && pnpm docs:api && next dev",
    "fix": "oxfmt",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint .",
    "start": "next start",
    "typecheck": "pnpm build:core && pnpm docs:api && fumadocs-mdx && next typegen && tsc --noEmit && pnpm check:includes && pnpm check:twoslash && pnpm check:sidebar",
    "docs:api": "tsx scripts/generate-docs.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:includes": "node scripts/check-includes.mjs",
    "check:sidebar": "node scripts/check-sidebar.mjs",
    "check:twoslash": "node scripts/check-twoslash.mjs",
    "docs:twoslash-cache": "tsx scripts/warm-twoslash-cache.mjs"
  },
  "dependencies": {
    "@ikenxuan/amagi": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "fumadocs-core": "16.15.9",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-openapi": "11.4.2",
    "fumadocs-twoslash": "^4.0.0",
    "fumadocs-ui": "16.15.9",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.4.3",
    "tailwind-merge": "^3.6.0",
    "twoslash": "^0.3.9",
    "winston": "^3.19.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "beautiful-mermaid": "1.1.3",
    "code-inspector-plugin": "^1.6.6",
    "cross-env": "10.1.0",
    "fumadocs-typescript": "5.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.13.7",
    "typescript": "^6.0.3"
  }
}

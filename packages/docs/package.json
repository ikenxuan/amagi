{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:core && pnpm docs:api && pnpm check:includes && pnpm check:sidebar && cross-env NODE_ENV=production next build && node scripts/post-export.mjs && pnpm check:links",
    "build:core": "pnpm --filter @ikenxuan/amagi build",
    "dev": "pnpm build:core && pnpm docs:api && next dev",
    "fix": "oxfmt",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint .",
    "start": "node scripts/preview.mjs",
    "typecheck": "pnpm build:core && pnpm docs:api && fumadocs-mdx && next typegen && tsc --noEmit && pnpm check:includes && pnpm check:sidebar",
    "docs:api": "pnpm --filter @ikenxuan/amagi run gen:openapi && tsx scripts/generate-docs.ts && tsx scripts/generate-api-types.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:includes": "node scripts/check-includes.mjs",
    "check:sidebar": "node scripts/check-sidebar.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@ikenxuan/amagi": "workspace:*",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.4",
    "fumadocs-openapi": "12.0.2",
    "fumadocs-twoslash": "^4.0.1",
    "fumadocs-ui": "16.15.14",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.4.3",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "beautiful-mermaid": "1.1.3",
    "code-inspector-plugin": "^1.6.6",
    "cross-env": "10.1.0",
    "fumadocs-typescript": "5.4.1",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}

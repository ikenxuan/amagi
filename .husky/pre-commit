#!/usr/bin/env sh
if ! git diff --cached --name-only --diff-filter=ACMRD | grep -q .; then
  exit 0
fi

echo "🧩 检测到暂存改动，更新 core 的 timestamp 字段..."
node --import tsx .husky/husky-tasks.ts
git add packages/core/package.json

# 只检查**暂存**的文件。未暂存的改动是半成品，拿它拦人只会逼出 `--no-verify`，
# 而 `--no-verify` 一开，这道钩子连同下面两步就全废了。
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED" ]; then
  exit 0
fi

# oxlint 只认 JS/TS。它是检查器：有问题就拦下来，不自动改。
#
# 两处 `|| true` 不是多余的：husky 用 `sh -e` 执行本脚本（出错即中止），
# 而 `grep` 无匹配时返回 1 —— 少了它，暂存区里恰好没有 JS/TS 文件时
# 钩子会以 1 退出、把正常提交一起拦掉。
LINT_FILES=$(echo "$STAGED" | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$' || true)
if [ -n "$LINT_FILES" ]; then
  echo "🧹 oxlint..."
  echo "$LINT_FILES" | tr '\n' '\0' | xargs -0 pnpm exec oxlint || exit 1
fi

# oxfmt 还管 json / css / md / yml，且**就地改写并重新暂存**。
# `.mdx`、`.html` 与被 ignorePatterns 命中的产物由 `--no-error-on-unmatched-pattern` 兜住：
# 全部命中忽略规则时它退出 0，而不是报「Expected at least one target file」。
FMT_FILES=$(echo "$STAGED" | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|json|css|md|yml|yaml)$' || true)
if [ -n "$FMT_FILES" ]; then
  echo "🎨 oxfmt..."
  echo "$FMT_FILES" | tr '\n' '\0' | xargs -0 pnpm exec oxfmt --no-error-on-unmatched-pattern
  echo "$FMT_FILES" | tr '\n' '\0' | xargs -0 git add
fi

# openapi.json 与 response-schemas.generated.ts 是 `pnpm openapi` 的产物：端点声明
# （zod 参数 / 响应类型 / 路由）一改，它们就得重跑生成器，否则 CI 的逐字节漂移门禁
# 必红 —— #192 就是改了搜索参数、忘了重跑，红在 `openapi/spec.test.ts` 上。把「重跑」
# 挪进钩子，人就不用记得了。
#
# 只在暂存区碰到 `core/src`（端点 / 契约 / 响应类型全在这下面）或生成脚本时才跑：
# 生成器约 5s，无脑每次 commit 都跑太重。`|| true` 同上：`sh -e` 下 grep 无匹配退 1 会
# 中止钩子。产物都在 oxfmt 的 ignorePatterns 里，这一步排在 oxfmt 之后也不会被回改。
#
# 局限（与上面 oxlint/oxfmt 同源）：生成器读的是**工作区**而非暂存区。若用 `git add -p`
# 只暂存了部分端点改动，产物会反映工作区的全部改动。日常「改完整段再提交」不受影响。
GEN_FILES=$(echo "$STAGED" | grep -E '^packages/core/(src|scripts)/' || true)
if [ -n "$GEN_FILES" ]; then
  echo "🧬 端点声明有改动，重新生成 openapi 产物..."
  pnpm --filter @ikenxuan/amagi run gen:openapi || exit 1
  git add packages/core/openapi.json packages/core/src/server/response-schemas.generated.ts
fi
